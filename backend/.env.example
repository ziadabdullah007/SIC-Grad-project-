# For local development, keep LLM_PROVIDER=off until a provider is configured.
# For a free-tier OpenAI-compatible provider (e.g. Groq, subject to its current terms):
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=llama-3.3-70b-versatile

# Alternative: local Ollama (not suitable on ordinary Render web services unless separately hosted)
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b

# Set this to the deployed frontend origin on Render, e.g. https://your-frontend.onrender.com
CORS_ORIGINS=http://localhost:5173
# Optional; default points to the repository-root data/ directory.
# DATA_DIR=../data
